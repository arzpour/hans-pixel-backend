# Supabase project: zetqjrrfkimfjggjirhp, region ap-south-1
# Dashboard → Project Settings → Database → Connection string → Session pooler
# The direct host is IPv6-only. Use the session pooler so it works on IPv4.
# Replace YOUR_DATABASE_PASSWORD with the database password, not the JWT secret.
DATABASE_URL=postgresql://postgres.zetqjrrfkimfjggjirhp:YOUR_DATABASE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Long random string. Used to hash sign-in codes and session tokens.
AUTH_SECRET=

# Comma-separated emails that can see who placed each received order.
ADMIN_EMAILS=hello@hanspixel.com

# Where the Next.js site runs. The browser sends the session cookie from here.
FRONTEND_ORIGIN=http://localhost:3000

# Public origin of this API. Direct (non-R2) upload URLs are built from it.
PUBLIC_BASE_URL=http://localhost:4000
PORT=4000

# Resend. When RESEND_API_KEY is empty outside production, the code is printed
# in the server log and returned to the browser.
RESEND_API_KEY=
EMAIL_FROM=Hans Pixel <orders@hanspixel.com>

# Cloudflare R2. Required for files larger than 32 MB, up to 100 GB per file.
# The browser uploads straight to the bucket. On the bucket CORS policy allow PUT and GET
# from your site origin, and expose the ETag header.
# AllowedOrigins: http://localhost:3000 and your production origin
# AllowedMethods: PUT, GET, HEAD
# AllowedHeaders: *
# ExposeHeaders: ETag
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# lax works for localhost and for a site and API that share a parent domain.
# Set none only when the site and API are on unrelated domains. That requires HTTPS.
COOKIE_SAMESITE=lax
